# Copy to .env (gitignored). Playwright docs captures only — not the Vue SPA.
# Identities: dev/docs-fixtures.md
# Seed: cd ../w4h-api && node bin/w4h seed-docs && npm run start:sample

W4H_APP_URL=http://127.0.0.1:5173

W4H_SUPERADMIN_EMAIL=superadmin@example.com
W4H_ADMIN_EMAIL=admin@example.com
W4H_USER_EMAIL=user@example.com

# Same password for all three after seed-docs. Default if unset: DocsOnly!2026
W4H_DOCS_PASSWORD=
